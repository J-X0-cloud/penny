# Port the server listens on. Railway sets this automatically.
PORT=8080
# Postgres for the transaction ledger. Leave unset to serve the bundled sample household.
# Run `penny-server migrate` (or `seed`) once after setting it.
DATABASE_URL="postgresql://penny:penny@localhost:5432/penny?sslmode=disable"
# Optional: trace, debug, info, notice, warning, error, critical
LOG_LEVEL=info
